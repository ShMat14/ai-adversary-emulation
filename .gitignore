# Trained checkpoints. Only results/models/v5/ is published, the policies behind
# the reported results (440 MB); every one is reproducible from
# analysis/v5_train.py with the seed recorded in the results JSON.
results/models/*
!results/models/v5/

# The released telemetry corpus, results/telemetry/v5/ (22 MB), regenerable by
# analysis/v5_corpus.py from the ten masked policies in results/models/v5/.
results/telemetry/*
!results/telemetry/v5/

# The MITRE ATT&CK bundle, 51 MB, downloaded rather than authored.
data/enterprise-attack.json

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Scratch
*.tmp
nohup.out
