# Journal-submission tooling. These are not merely build scripts: they carry the
# manuscript itself as embedded strings (check_abstract.py holds the abstract,
# build_common.py the shared body content), so publishing them would publish an
# unsubmitted paper.
build_common.py
build_docx.py
build_docx_scn.py
build_ieee.py
build_jisa.py
build_scn.py
check_abstract.py
